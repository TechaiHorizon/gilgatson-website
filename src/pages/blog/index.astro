---
import BaseLayout from '../../layouts/BaseLayout.astro';

// Get all blog posts dynamically
const allPosts = await Astro.glob('./*.md');

// Sort by date (newest first)
const sortedPosts = allPosts.sort((a, b) => {
  const dateA = new Date(a.frontmatter.pubDate);
  const dateB = new Date(b.frontmatter.pubDate);
  return dateB.getTime() - dateA.getTime();
});

// Separate briefings and articles
const briefings = sortedPosts.filter(post => post.frontmatter.title.includes('Daily Tech Briefing'));
const articles = sortedPosts.filter(post => !post.frontmatter.title.includes('Daily Tech Briefing'));
---

<BaseLayout 
  title="Analysis - Gil Gatson"
  description="Geopolitical analysis, tech insights, and daily briefings on AI, semiconductors, and US-China competition."
>
  <section class="hero">
    <h1>Analysis</h1>
    <p class="intro">
      Geopolitical analysis, tech insights, and daily briefings on AI, semiconductors, and US-China competition.
    </p>
  </section>
  
  <div class="container">
    <!-- Daily Briefings Section -->
    {briefings.length > 0 && (
      <section class="briefings-section">
        <h2 class="section-title">Daily Tech Briefings</h2>
        <div class="blog-grid">
          {briefings.map((post) => (
            <article class="blog-card briefing-card">
              <h3><a href={post.url}>{post.frontmatter.title}</a></h3>
              <p class="meta">{post.frontmatter.pubDate}</p>
              <p>{post.frontmatter.description}</p>
              <a href={post.url} class="read-more">Read briefing →</a>
            </article>
          ))}
        </div>
      </section>
    )}
    
    <!-- Articles Section -->
    <section class="articles-section">
      <h2 class="section-title">Latest Analysis</h2>
      <div class="blog-grid">
        {articles.map((post) => (
          <article class="blog-card">
            <h3><a href={post.url}>{post.frontmatter.title}</a></h3>
            <p class="meta">{post.frontmatter.pubDate}</p>
            <p>{post.frontmatter.description}</p>
            <a href={post.url} class="read-more">Read more →</a>
          </article>
        ))}
      </div>
    </section>
  </div>

  <style>
    .hero {
      text-align: center;
      padding: 4rem 2rem 5rem;
      margin: 0 0 4rem 0;
      background: linear-gradient(135deg, #1a1a2e 0%, #16213e 50%, #0f3460 100%);
      position: relative;
      overflow: hidden;
    }
    
    .hero::before {
      content: '';
      position: absolute;
      top: 0;
      left: 0;
      right: 0;
      bottom: 0;
      background: 
        radial-gradient(circle at 20% 50%, rgba(41, 128, 185, 0.1) 0%, transparent 50%),
        radial-gradient(circle at 80% 80%, rgba(142, 68, 173, 0.1) 0%, transparent 50%);
      pointer-events: none;
    }
    
    .hero h1 {
      position: relative;
      z-index: 1;
      color: #ffffff;
      font-size: 3rem;
      font-weight: 700;
      letter-spacing: -0.02em;
      margin-bottom: 1rem;
    }
    
    .intro {
      position: relative;
      z-index: 1;
      text-align: center;
      color: #e0e0e0;
      margin-bottom: 0;
      font-size: 1.25rem;
      max-width: 800px;
      margin-left: auto;
      margin-right: auto;
    }
    
    .briefings-section,
    .articles-section {
      margin-bottom: 4rem;
    }
    
    .section-title {
      font-size: 2rem;
      margin-bottom: 2rem;
      padding-bottom: 0.5rem;
      border-bottom: 2px solid var(--color-border);
    }
    
    .blog-grid {
      display: grid;
      gap: 2rem;
      margin-bottom: 2rem;
    }
    
    .blog-card {
      padding: 2rem;
      background: white;
      border: 1px solid var(--color-border);
      border-radius: 8px;
      transition: box-shadow 0.2s;
    }
    
    .blog-card:hover {
      box-shadow: 0 4px 6px rgba(0, 0, 0, 0.1);
    }
    
    .briefing-card {
      background: linear-gradient(135deg, #e3f2fd 0%, #f3e5f5 100%);
      border-color: #2196f3;
    }
    
    .blog-card h3 {
      margin-bottom: 0.5rem;
      font-size: 1.5rem;
    }
    
    .blog-card h3 a {
      color: var(--color-text);
      text-decoration: none;
    }
    
    .blog-card h3 a:hover {
      color: var(--color-accent);
    }
    
    .meta {
      font-size: 0.875rem;
      color: var(--color-gray);
      margin-bottom: 1rem;
    }
    
    .read-more {
      display: inline-block;
      margin-top: 0.5rem;
      color: var(--color-accent);
      text-decoration: none;
      font-weight: 600;
    }
    
    .read-more:hover {
      text-decoration: underline;
    }
    
    @media (max-width: 768px) {
      .hero h1 {
        font-size: 2rem;
      }
      
      .intro {
        font-size: 1rem;
      }
    }
  </style>
</BaseLayout>
